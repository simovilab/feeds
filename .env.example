# Domain that Traefik will route to this feed server.
FEEDS_DOMAIN=feeds.simovi.org

# Name of the external Docker network shared with Traefik.
TRAEFIK_NETWORK=traefik_proxy

# Name of the Traefik certificate resolver used for TLS.
TRAEFIK_CERT_RESOLVER=letsencrypt

# Host path where GTFS feed files are stored, e.g.:
#   gtfs-data/incofer/schedule/feed.zip
#   gtfs-data/bucr/schedule/feed.zip
GTFS_DATA_PATH=./gtfs-data